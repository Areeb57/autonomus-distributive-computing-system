# =============================================================================
# ADC Backend — Environment Configuration
# Copy this file to .env and fill in actual values for local development.
# NEVER commit .env with real secrets.
# =============================================================================

# ---------- Application ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql+asyncpg://adc:adc_dev_password@localhost:5432/adc_db

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Storage ----------
STORAGE_ROOT=./storage
UPLOAD_MAX_SIZE_MB=10240
ALLOWED_DATASET_EXTENSIONS=.tar.gz,.zip,.tar,.gz,.hdf5,.parquet,.csv
ALLOWED_PACKAGE_EXTENSIONS=.zip,.tar.gz,.tar

# ---------- Machine Identity ----------
MACHINE_KEY_ALGORITHM=Ed25519
PAIRING_CODE_EXPIRY_SECONDS=300
PAIRING_MAX_ATTEMPTS=5

# ---------- Heartbeat and Leases ----------
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=90
LEASE_DURATION_SECONDS=300

# ---------- Resource Defaults ----------
DEFAULT_CPU_BUDGET_PERCENT=50
DEFAULT_RAM_BUDGET_GB=4
DEFAULT_STORAGE_BUDGET_GB=20

# ---------- Training ----------
EXECUTION_BACKEND=subprocess
CHECKPOINT_INTERVAL_STEPS=500
MAX_TRAINING_RUNTIME_HOURS=48

# ---------- WebSocket ----------
WS_HEARTBEAT_INTERVAL=15
WS_MAX_MESSAGE_SIZE=1048576

# ---------- Logging ----------
LOG_FORMAT=json
LOG_FILE=./storage/logs/adc.log
LOG_ROTATION_MB=50
LOG_RETENTION_COUNT=5
