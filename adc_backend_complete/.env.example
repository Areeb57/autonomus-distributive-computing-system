# Local database file. Relative paths are resolved from where the process starts.
ADC_BACKEND_DB=./adc_backend.sqlite3

# Optional. If set, adc_agent.py must be started with --registration-token matching this value.
# Leave unset only for LOCAL DEVELOPMENT. Do not expose an unprotected backend to the public internet.
# ADC_REGISTRATION_TOKEN=replace-with-a-long-random-secret

# Extra browser origins, comma-separated (add your deployed website origin here).
# ADC_ALLOWED_ORIGINS=https://your-website.example
